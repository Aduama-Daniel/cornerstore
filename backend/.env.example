# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=your_mongodb_connection_string

# Firebase Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
# Optional: JSON stringified service account for production
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id"}

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Paystack Configuration
PAYSTACK_SECRET_KEY=your_paystack_secret_key
# Optional; defaults to PAYSTACK_SECRET_KEY. Set only if Paystack gives you a separate webhook secret.
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key

# Admin Authentication
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD_HASH=your_sha256_password_hash

# AI Product Repurposing (admin module)
# LLM defaults to Gemini using GEMINI_API_KEY above; override here if needed.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Image model also defaults to Gemini (image-capable model) using GEMINI_API_KEY.
IMAGE_MODEL_PROVIDER=gemini
IMAGE_MODEL_API_KEY=
IMAGE_MODEL_NAME=gemini-2.5-flash-image
IMAGE_OUTPUT_SIZE=1024x1024
IMAGE_OUTPUT_FORMAT=png
